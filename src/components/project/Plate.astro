---
/**
 * Tavola / foto cliccabile: miniatura ottimizzata dentro un <button> che apre il lightbox
 * condiviso (contratto data-lb-*, vedi src/scripts/lightbox.ts).
 * Usata da intro, line up e archivio delle pagine progetto.
 */
import { Image, getImage } from 'astro:assets';
import T from '../T.astro';
import { img } from '../../lib/images';
import { ui, type Bi } from '../../lib/i18n';

interface Props {
  path: string;
  alt: string;
  /** gruppo del lightbox: prev/next scorrono solo dentro lo stesso gruppo */
  group: string;
  /** didascalia nel lightbox */
  lbCaption: Bi;
  /** didascalia visibile sotto la tavola (facoltativa) */
  caption?: Bi;
  sizes: string;
  widths?: number[];
  /** rapporto larghezza/altezza del riquadro; se assente quello dell'immagine */
  ar?: number;
  class?: string;
  [attr: string]: unknown;
}

const {
  path,
  alt,
  group,
  lbCaption,
  caption,
  sizes,
  widths = [400, 640, 960, 1280],
  ar,
  class: className,
  ...rest
} = Astro.props;

const meta = img(path);
const frame = ar ?? meta.width / meta.height;

// Versione grande per il lightbox (mai ingrandita oltre l'originale).
// I PNG trasparenti vengono appoggiati sul bianco della tavola.
const big = await getImage({
  src: meta,
  width: Math.min(1800, meta.width),
  format: 'webp',
  ...(meta.format === 'png' ? { background: '#fbfaf6' } : {}),
});
---
<figure class:list={['pj-plate', className]} style={`--ar: ${frame.toFixed(4)}`} {...rest}>
  <button
    type="button"
    class="pj-plate__btn"
    data-lb-item
    data-lb-group={group}
    data-lb-src={big.src}
    data-lb-alt={alt}
    data-lb-caption={lbCaption.it}
    data-lb-caption-en={lbCaption.en}
  >
    <span class="sr-only"><T t={ui.enlarge} />:</span>
    <Image src={meta} alt={alt} widths={widths} sizes={sizes} format="webp" />
    <span class="pj-plate__zoom" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="M20 20l-4.8-4.8M10.5 8v5M8 10.5h5"></path>
      </svg>
    </span>
  </button>
  {caption && <figcaption class="pj-plate__cap"><T t={caption} /></figcaption>}
</figure>

<style>
  .pj-plate {
    margin: 0;
    min-width: 0;
  }

  .pj-plate__btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--plate);
    aspect-ratio: var(--ar);
    overflow: hidden;
    cursor: zoom-in;
    color: inherit;
  }

  .pj-plate__btn > :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.8s var(--ease-out-quart);
  }
  .pj-plate__btn:hover > :global(img) { transform: scale(1.015); }

  .pj-plate__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* lente: compare al passaggio / al focus, sempre visibile sui touch */
  .pj-plate__zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    opacity: 0;
    transform: translateY(6px) scale(0.92);
    transition:
      opacity 0.25s var(--ease-out-quart),
      transform 0.45s var(--ease-out-expo);
  }
  .pj-plate__btn:hover .pj-plate__zoom,
  .pj-plate__btn:focus-visible .pj-plate__zoom {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .pj-plate__zoom {
      width: 32px;
      height: 32px;
      opacity: 0.92;
      transform: none;
    }
  }

  .pj-plate__cap {
    margin-top: 10px;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .pj-plate__btn > :global(img) { transition: none; }
    .pj-plate__btn:hover > :global(img) { transform: none; }
  }
</style>
