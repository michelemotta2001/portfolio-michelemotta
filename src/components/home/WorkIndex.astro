---
/**
 * Indice dei lavori: una riga-link per lavoro (numero, titolo, tipo, anno).
 * Le righe rispettano il filtro attivo e, su desktop, accendono il progetto in evidenza.
 */
import T from '../T.astro';
import { ui } from '../../lib/i18n';
import { pad2, workHref, type Project } from '../../lib/data';

interface Props {
  works: { p: Project; num: string }[];
}

const { works } = Astro.props;
---
<section class="idx wrap" aria-labelledby="idx-title">
  <div class="idx__head">
    <h3 id="idx-title" class="label"><T t={ui.index} /></h3>
    <span class="label idx__count" aria-hidden="true">{pad2(works.length)}</span>
  </div>

  <ol class="idx__list">
    {works.map((w, i) => (
      <li class="idx__item reveal" style={`--reveal-delay: ${i * 60}ms`}>
        <a class="row" href={workHref(w.p.slug)} data-work={i} data-tags={w.p.tags.join('|')}>
          <span class="row__num">{w.num}</span>
          <span class="row__title display">{w.p.title}</span>
          <span class="row__meta">
            <T t={w.p.kind} class="row__kind" />
            <span class="row__year">{w.p.year}</span>
          </span>
          <svg class="row__arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .idx { margin-top: var(--section); }
  @media (min-width: 1024px) {
    .idx { margin-top: var(--space-3xl); }
  }

  .idx__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--line);
  }
  .idx__count { font-variant-numeric: tabular-nums; }

  /* --- riga: desktop a cinque colonne ------------------------------------- */
  .row {
    --pad: var(--space-sm);
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 15rem) minmax(0, 9rem) 24px;
    align-items: center;
    column-gap: var(--space-md);
    min-height: 44px;
    padding: var(--space-md) var(--pad);
    margin-inline: calc(-1 * var(--pad)); /* lo sfondo al passaggio sborda appena, il testo resta in griglia */
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease-out-quart),
      opacity 0.3s var(--ease-out-quart);
  }
  .row:hover,
  .row:focus-visible { background: var(--ink-2); }
  .row:focus-visible { outline-offset: -2px; }

  .row__num {
    font-size: var(--step--1);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .row__title {
    font-size: var(--step-3);
    color: var(--paper);
    transition: transform 0.45s var(--ease-out-expo);
  }
  .row:hover .row__title,
  .row:focus-visible .row__title { transform: translateX(10px); }

  /* su desktop tipo e anno diventano due colonne della griglia */
  .row__meta { display: contents; }
  .row__meta :global(.row__kind) { font-size: var(--step--1); color: var(--text-2); }
  .row__year {
    font-size: var(--step--1);
    color: var(--muted);
    text-align: right;
  }

  .row__arrow {
    justify-self: end;
    color: var(--muted);
    transition:
      transform 0.3s var(--ease-out-expo),
      color 0.2s var(--ease-out-quart);
  }
  .row:hover .row__arrow,
  .row:focus-visible .row__arrow { color: var(--accent); transform: translate(3px, -3px); }

  /* filtro attivo */
  .row.is-dim { opacity: 0.18; }
  .row.is-dim:hover,
  .row.is-dim:focus-visible { opacity: 0.6; }

  /* --- tablet: tipo e anno impilati a destra -------------------------------- */
  @media (max-width: 1023px) {
    .row { grid-template-columns: 2.75rem minmax(0, 1fr) auto 22px; }
    .row__meta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      line-height: 1.4;
    }
  }

  /* --- telefono: numero + titolo su una riga, tipo e anno sotto -------------- */
  @media (max-width: 599px) {
    .row {
      grid-template-columns: 2.25rem minmax(0, 1fr) 22px;
      grid-template-areas:
        'num title arrow'
        '.   meta  arrow';
      align-items: baseline;
      row-gap: var(--space-3xs);
      column-gap: var(--space-xs);
      padding-block: var(--space-sm);
    }
    .row__num { grid-area: num; }
    .row__title { grid-area: title; }
    .row__arrow { grid-area: arrow; align-self: center; }
    .row__meta {
      grid-area: meta;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 var(--space-xs);
      text-align: left;
    }
    .row__year { text-align: left; }
    .row__year::before { content: '·'; margin-right: var(--space-xs); color: var(--line-strong); }
  }

  @media (prefers-reduced-motion: reduce) {
    .row:hover .row__title,
    .row:focus-visible .row__title,
    .row:hover .row__arrow,
    .row:focus-visible .row__arrow { transform: none; }
  }
</style>
