---
import T from './T.astro';
import { ui, collabMail, mailtoHref } from '../lib/i18n';
import { site } from '../lib/data';

// "Collaboriamo": mail a Michele già pronta, in italiano o inglese secondo la lingua scelta
const collabIt = mailtoHref(site.contacts.email, collabMail.subject.it, collabMail.body.it);
const collabEn = mailtoHref(site.contacts.email, collabMail.subject.en, collabMail.body.en);

/** In homepage le ancore sono locali; nelle altre pagine puntano alla home. */
const { home = false } = Astro.props as { home?: boolean };
const base = home ? '' : '/';
---
<a class="skip-link" href="#main"><T t={ui.skip} /></a>
<header class="site-header" data-header>
  <div class="wrap site-header__in">
    <a class="brand" href="/" aria-label="Michele Motta — homepage">
      <span class="brand__name">Michele Motta</span>
      <span class="brand__role">fashion &amp; knitwear designer</span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-btn>
      <span class="sr-only"><T t={ui.menu} /></span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path class="menu-btn__top" d="M4 8h16" /><path class="menu-btn__bottom" d="M4 16h16" />
      </svg>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Principale" data-menu>
      <a href={`${base}#lavori`}><T t={ui.works} /></a>
      <a href={`${base}#about`}><T t={ui.about} /></a>
      <a href={`${base}#percorso`}><T t={ui.path} /></a>
      <a href="#contatti"><T t={ui.contact} /></a>
      <div class="lang" role="group" aria-label="Lingua / Language">
        <button type="button" data-lang="it" aria-pressed="true">IT</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <a class="cta" href={collabIt} data-href-it={collabIt} data-href-en={collabEn}><T t={ui.collab} /></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    /* notch / isola dinamica quando il sito è aperto a schermo intero */
    padding-top: env(safe-area-inset-top, 0px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-out-quart);
  }
  /* sfondo sfocato su uno strato a parte: un backdrop-filter sull'header stesso
     farebbe da contenitore al menu fixed, che resterebbe chiuso nell'altezza dell'header */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in oklch, var(--ink) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
  }
  :global(.is-scrolled) .site-header { border-bottom-color: var(--line); }

  .site-header__in {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px; /* area di tocco piena anche se il testo è basso */
    line-height: 1.05;
    text-decoration: none;
    color: var(--paper);
  }
  .brand__name {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1.1875rem;
    letter-spacing: 0.03em;
  }
  .brand__role { font-size: 0.6875rem; font-weight: 700; color: var(--muted); }
  .brand:hover .brand__name { color: var(--accent); }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--step--1);
  }
  .site-nav > a { text-decoration: none; padding-block: var(--space-xs); }
  .site-nav > a:not(.cta):hover { color: var(--accent); }

  .lang { display: flex; align-items: center; gap: 2px; color: var(--muted); }
  .lang button {
    background: none;
    border: 0;
    padding: var(--space-xs) 4px;
    color: var(--muted);
    font-size: var(--step--1);
    min-width: 32px;
  }
  .lang button[aria-pressed='true'] { color: var(--paper); font-weight: 700; }
  .lang button:hover { color: var(--accent); }

  .cta {
    background: var(--paper);
    color: var(--ink);
    padding: var(--space-xs) var(--space-sm);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.25s var(--ease-out-quart), color 0.25s var(--ease-out-quart);
  }
  .cta:hover { background: var(--accent); color: var(--ink); }

  .menu-btn {
    display: none;
    background: none;
    border: 0;
    width: 44px;
    height: 44px;
    place-items: center;
    color: var(--paper);
    margin-right: -10px;
  }
  .menu-btn path { transition: transform 0.35s var(--ease-out-quart); transform-origin: center; }
  .menu-btn[aria-expanded='true'] .menu-btn__top { transform: translateY(4px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-btn__bottom { transform: translateY(-4px) rotate(-45deg); }

  /* Telefono e iPad verticale: menu a tutto schermo con le voci in Anton */
  @media (max-width: 860px) {
    .menu-btn { display: grid; position: relative; z-index: calc(var(--z-menu) + 1); }
    .site-nav {
      position: fixed;
      inset: 0;
      z-index: var(--z-menu);
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
      /* sotto l'header (con la safe area), sopra la barra home dell'iPhone */
      padding:
        calc(var(--header-h) + env(safe-area-inset-top, 0px) + var(--space-md))
        var(--gutter)
        calc(var(--space-xl) + env(safe-area-inset-bottom, 0px));
      /* telefono in orizzontale: se le voci non stanno, il menu scorre invece di tagliarle */
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--ink);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity 0.35s var(--ease-out-quart), transform 0.45s var(--ease-out-expo), visibility 0s linear 0.35s;
    }
    .site-nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.35s var(--ease-out-quart), transform 0.45s var(--ease-out-expo), visibility 0s;
    }
    /* centrate in verticale, ma "safe": se il contenuto è più alto dello schermo parte dall'alto */
    .site-nav > :first-child { margin-top: auto; }
    .site-nav > :last-child { margin-bottom: auto; }
    .site-nav > a:not(.cta) {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-family: var(--font-display);
      text-transform: uppercase;
      /* grandi in verticale, ridotte quando lo schermo è basso (telefono in orizzontale) */
      font-size: min(clamp(2.75rem, 12vw, 4.5rem), 9.5svh);
      line-height: 1.05;
      padding: 0;
      color: var(--paper);
    }
    .lang { margin-top: var(--space-md); margin-left: -12px; font-size: var(--step-1); }
    .lang button { font-size: var(--step-1); min-width: 44px; min-height: 44px; }
    .cta {
      display: inline-flex;
      align-items: center;
      min-height: 52px;
      margin-top: var(--space-xs);
      padding: 0 var(--space-md);
      font-size: var(--step-1);
    }
  }

  /* telefono in orizzontale: voci a sinistra, lingua e "Collaboriamo" a destra, tutto in uno schermo */
  @media (max-width: 860px) and (max-height: 480px) {
    .site-nav {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: repeat(4, 54px); /* righe uguali: il ritmo delle voci non cambia accanto a lingua e CTA */
      align-items: center;
      grid-auto-flow: column;
      align-content: center;
      align-content: safe center;
      column-gap: var(--space-xl);
      row-gap: 0;
      padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
    }
    .site-nav > :first-child,
    .site-nav > :last-child { margin-block: 0; }
    .site-nav > a:not(.cta) { justify-self: start; }
    .lang { grid-column: 2; grid-row: 2; margin: 0 0 0 -12px; }
    .cta { grid-column: 2; grid-row: 3; justify-self: start; margin: 0; }
  }
</style>
