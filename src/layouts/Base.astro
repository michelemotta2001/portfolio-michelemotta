---
/**
 * Layout comune. Ogni pagina passa titolo, descrizione e il colore del progetto (accent).
 * Header (menu, IT/EN) e footer (contatti) sono uguali ovunque.
 */
import '@fontsource/anton/latin-400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  accent?: string;
  image?: ImageMetadata;
  home?: boolean;
}

const { title, description, accent = '#C8B79A', image, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
const og = image ? await getImage({ src: image, width: 1200, format: 'jpeg' }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#121110" />
    <!-- ICO per Safari e browser vecchi, SVG per i moderni, PNG per la schermata Home di iPhone/iPad -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Michele Motta" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body style={`--accent: ${accent}`}>
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
